{
  "name": "Fsub Bot Heroku",
  "description": "Bot Telegram Force Subscribe untuk Heroku",
  "keywords": ["telegram", "pyrogram", "fsub", "bot"],
  "repository": "https://github.com/ciosukasuka/ciofsub",
  "logo": "https://pyrogram.org/img/pyrogram-logo.png",
  "stack": "heroku-22",
  "buildpacks": [
    {
      "url": "heroku/python"
    }
  ],
  "env": {
    "API_ID": {
      "description": "API ID dari https://my.telegram.org",
      "required": true
    },
    "API_HASH": {
      "description": "API HASH dari https://my.telegram.org", 
      "required": true
    },
    "BOT_TOKEN": {
      "description": "Bot Token dari @BotFather",
      "required": true
    },
    "CHANNEL_ID": {
      "description": "ID Channel Wajib Join. Contoh: -1001234567890",
      "required": true
    },
    "LOG_CHANNEL": {
      "description": "ID Channel untuk Log. Bisa sama dengan CHANNEL_ID",
      "required": true
    },
    "ADMINS": {
      "description": "ID Telegram kamu. Ambil dari @userinfobot",
      "required": true
    },
    "DB_URI": {
      "description": "Link MongoDB Atlas. Opsional",
      "required": false
    },
    "DB_NAME": {
      "description": "Nama Database MongoDB",
      "value": "fsub"
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "basic"
    }
  }
}
